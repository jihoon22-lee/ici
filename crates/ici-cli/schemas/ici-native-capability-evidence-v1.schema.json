{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihoon22-lee/ici/schemas/ici-native-capability-evidence-v1.schema.json",
  "title": "ici native capability evidence v1",
  "description": "Native-only top-level key native_capability_evidence of a legacy ici.result/v3 verify suite. One entry per capability_inventory.tools row, in the same order: how the executable was resolved, its content digest and the task record of the row's selected version probe (null when the row has no probe outcome). Metadata-probe results are capability_inventory.tools[].evidence, not this object; it is not a journal of every candidate probe.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "tools"],
  "properties": {
    "schema_id": { "const": "ici.native.capability-evidence" },
    "schema_version": { "const": 1 },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "origin", "sha256", "probe"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "origin": {
          "type": "string",
          "enum": ["explicit", "pack", "project", "path", "unresolved"]
        },
        "sha256": {
          "oneOf": [
            { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "probe": {
          "oneOf": [
            { "$ref": "#/$defs/probe" },
            { "type": "null" }
          ]
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id", "argv", "state", "exit_code", "timed_out", "truncated", "cancelled",
        "signal", "executed", "cleanup"
      ],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "state": {
          "type": "string",
          "enum": ["READY", "RUNNING", "SUCCEEDED", "FAILED", "BLOCKED", "CANCELLED"]
        },
        "exit_code": { "type": ["integer", "null"] },
        "timed_out": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "cancelled": { "type": "boolean" },
        "signal": { "type": ["integer", "null"] },
        "executed": { "type": "boolean" },
        "cleanup": { "$ref": "#/$defs/cleanup" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "survivors", "interrupted", "escalated"],
      "properties": {
        "group": { "type": ["integer", "null"] },
        "survivors": {
          "oneOf": [
            { "type": "array", "items": { "type": "integer" } },
            { "type": "null" }
          ]
        },
        "interrupted": { "type": "boolean" },
        "escalated": { "type": "boolean" }
      }
    }
  }
}
