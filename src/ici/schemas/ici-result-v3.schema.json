{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihoon22-lee/ici/schemas/ici-result-v3.schema.json",
  "title": "ici.result/v3",
  "description": "Canonical ici suite or standalone-engine result contract.",
  "oneOf": [
    { "$ref": "#/$defs/suite" },
    { "$ref": "#/$defs/engine" }
  ],
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL", "ERROR", "SKIP"]
    },
    "nullableNumber": {
      "type": ["number", "null"]
    },
    "nullableInteger": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "start_line",
        "end_line",
        "start_column",
        "end_column",
        "label"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "$ref": "#/$defs/nullableInteger" },
        "start_column": { "$ref": "#/$defs/nullableInteger" },
        "end_column": { "$ref": "#/$defs/nullableInteger" },
        "label": { "type": "string" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string" }
      }
    },
    "suppression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suppressed", "kind", "reason"],
      "properties": {
        "suppressed": { "type": "boolean" },
        "kind": {
          "type": "string",
          "enum": ["none", "inline", "config", "baseline"]
        },
        "reason": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "category",
        "severity",
        "confidence",
        "fingerprint",
        "primary_location",
        "related_locations",
        "message",
        "explanation",
        "remediation",
        "tool_rule_id",
        "tool_name",
        "tool_version",
        "suppression",
        "metrics",
        "snippet"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^ici\\.[a-z0-9][a-z0-9.-]*$"
        },
        "category": {
          "type": "string",
          "enum": [
            "correctness",
            "type",
            "security",
            "resource",
            "build",
            "test",
            "maintainability",
            "architecture",
            "compatibility"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "confidence": {
          "type": "string",
          "enum": ["exact", "high", "medium", "low"]
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "primary_location": { "$ref": "#/$defs/location" },
        "related_locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/location" }
        },
        "message": { "type": "string" },
        "explanation": { "type": "string" },
        "remediation": { "type": "string" },
        "tool_rule_id": { "type": "string" },
        "tool_name": { "type": "string" },
        "tool_version": { "type": "string" },
        "suppression": { "$ref": "#/$defs/suppression" },
        "metrics": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/metric" }
        },
        "snippet": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_path",
        "start_line",
        "end_line",
        "start_column",
        "end_column",
        "target_name",
        "status",
        "message",
        "snippet",
        "metrics"
      ],
      "properties": {
        "file_path": { "type": "string" },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "$ref": "#/$defs/nullableInteger" },
        "start_column": { "$ref": "#/$defs/nullableInteger" },
        "end_column": { "$ref": "#/$defs/nullableInteger" },
        "target_name": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "message": { "type": "string" },
        "snippet": { "type": "string" },
        "metrics": { "type": "object" }
      }
    },
    "toolEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "version",
        "argv",
        "returncode",
        "timed_out",
        "truncated",
        "error"
      ],
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "version": { "type": "string" },
        "argv": { "type": "array", "items": { "type": "string" } },
        "returncode": { "type": ["integer", "null"] },
        "timed_out": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "engine_name",
        "status",
        "summary",
        "score",
        "max_score",
        "duration",
        "raw_output",
        "extra",
        "required",
        "evidence",
        "tool_evidence",
        "targets",
        "findings"
      ],
      "properties": {
        "schema_version": { "const": "ici.result/v3" },
        "engine_name": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "summary": { "type": "string" },
        "score": { "$ref": "#/$defs/nullableNumber" },
        "max_score": { "$ref": "#/$defs/nullableNumber" },
        "duration": { "type": "number", "minimum": 0 },
        "raw_output": { "type": "string" },
        "extra": { "type": "object" },
        "required": { "type": "boolean" },
        "evidence": {
          "type": "string",
          "enum": ["MEASURED", "ESTIMATED", "NOT_RUN", "NOT_APPLICABLE"]
        },
        "tool_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolEvidence" }
        },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/target" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "suite_status",
        "duration",
        "passed_count",
        "warned_count",
        "failed_count",
        "error_count",
        "skipped_count",
        "total_count",
        "tem_score",
        "max_tem_score",
        "results"
      ],
      "properties": {
        "schema_version": { "const": "ici.result/v3" },
        "suite_status": { "$ref": "#/$defs/status" },
        "duration": { "type": "number", "minimum": 0 },
        "passed_count": { "type": "integer", "minimum": 0 },
        "warned_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 },
        "error_count": { "type": "integer", "minimum": 0 },
        "skipped_count": { "type": "integer", "minimum": 0 },
        "total_count": { "type": "integer", "minimum": 0 },
        "tem_score": { "$ref": "#/$defs/nullableNumber" },
        "max_tem_score": { "type": "number", "minimum": 0 },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/engine" }
        }
      }
    }
  }
}
