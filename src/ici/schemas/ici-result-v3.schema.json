{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihoon22-lee/ici/schemas/ici-result-v3.schema.json",
  "title": "ici.result/v3",
  "description": "Canonical ici suite or standalone-engine result contract.",
  "oneOf": [
    { "$ref": "#/$defs/suite" },
    { "$ref": "#/$defs/engine" }
  ],
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL", "ERROR", "SKIP"]
    },
    "nullableNumber": {
      "type": ["number", "null"]
    },
    "nullableInteger": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "start_line",
        "end_line",
        "start_column",
        "end_column",
        "label"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "$ref": "#/$defs/nullableInteger" },
        "start_column": { "$ref": "#/$defs/nullableInteger" },
        "end_column": { "$ref": "#/$defs/nullableInteger" },
        "label": { "type": "string" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string" }
      }
    },
    "suppression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suppressed", "kind", "reason"],
      "properties": {
        "suppressed": { "type": "boolean" },
        "kind": {
          "type": "string",
          "enum": ["none", "inline", "config", "baseline"]
        },
        "reason": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "category",
        "severity",
        "confidence",
        "fingerprint",
        "primary_location",
        "related_locations",
        "message",
        "explanation",
        "remediation",
        "tool_rule_id",
        "tool_name",
        "tool_version",
        "suppression",
        "metrics",
        "snippet"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^ici\\.[a-z0-9][a-z0-9.-]*$"
        },
        "category": {
          "type": "string",
          "enum": [
            "correctness",
            "type",
            "security",
            "resource",
            "build",
            "test",
            "maintainability",
            "architecture",
            "compatibility"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "confidence": {
          "type": "string",
          "enum": ["exact", "high", "medium", "low"]
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "primary_location": { "$ref": "#/$defs/location" },
        "related_locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/location" }
        },
        "message": { "type": "string" },
        "explanation": { "type": "string" },
        "remediation": { "type": "string" },
        "tool_rule_id": { "type": "string" },
        "tool_name": { "type": "string" },
        "tool_version": { "type": "string" },
        "suppression": { "$ref": "#/$defs/suppression" },
        "metrics": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/metric" }
        },
        "snippet": { "type": "string" }
      }
    },
    "analysisMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_version",
        "fingerprint_version",
        "policy_digest",
        "tool_policy_digest"
      ],
      "properties": {
        "producer_version": { "type": "string", "minLength": 1 },
        "fingerprint_version": { "type": "string", "minLength": 1 },
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "tool_policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "nullableAnalysisMetadata": {
      "oneOf": [
        { "$ref": "#/$defs/analysisMetadata" },
        { "type": "null" }
      ]
    },
    "findingDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "engine_name",
        "fingerprint",
        "rule_id",
        "message",
        "current_location",
        "baseline_location",
        "current_severity",
        "baseline_severity",
        "regressed",
        "suppressed",
        "gated"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["new", "unchanged", "moved", "resolved"]
        },
        "engine_name": { "type": "string", "minLength": 1 },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rule_id": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "current_location": {
          "oneOf": [
            { "$ref": "#/$defs/location" },
            { "type": "null" }
          ]
        },
        "baseline_location": {
          "oneOf": [
            { "$ref": "#/$defs/location" },
            { "type": "null" }
          ]
        },
        "current_severity": {
          "type": ["string", "null"],
          "enum": ["info", "low", "medium", "high", "critical", null]
        },
        "baseline_severity": {
          "type": ["string", "null"],
          "enum": ["info", "low", "medium", "high", "critical", null]
        },
        "regressed": { "type": "boolean" },
        "suppressed": { "type": "boolean" },
        "gated": { "type": "boolean" }
      }
    },
    "baselineComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "warnings",
        "baseline_metadata",
        "fail_on_new",
        "gate_failed",
        "new_count",
        "unchanged_count",
        "moved_count",
        "resolved_count",
        "regressed_count",
        "gated_count",
        "entries"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "baseline_metadata": { "$ref": "#/$defs/nullableAnalysisMetadata" },
        "fail_on_new": { "type": "boolean" },
        "gate_failed": { "type": "boolean" },
        "new_count": { "type": "integer", "minimum": 0 },
        "unchanged_count": { "type": "integer", "minimum": 0 },
        "moved_count": { "type": "integer", "minimum": 0 },
        "resolved_count": { "type": "integer", "minimum": 0 },
        "regressed_count": { "type": "integer", "minimum": 0 },
        "gated_count": { "type": "integer", "minimum": 0 },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/findingDelta" }
        }
      }
    },
    "nullableBaselineComparison": {
      "oneOf": [
        { "$ref": "#/$defs/baselineComparison" },
        { "type": "null" }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_path",
        "start_line",
        "end_line",
        "start_column",
        "end_column",
        "target_name",
        "status",
        "message",
        "snippet",
        "metrics"
      ],
      "properties": {
        "file_path": { "type": "string" },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "$ref": "#/$defs/nullableInteger" },
        "start_column": { "$ref": "#/$defs/nullableInteger" },
        "end_column": { "$ref": "#/$defs/nullableInteger" },
        "target_name": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "message": { "type": "string" },
        "snippet": { "type": "string" },
        "metrics": { "type": "object" }
      }
    },
    "toolEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "version",
        "argv",
        "returncode",
        "timed_out",
        "truncated",
        "error"
      ],
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "version": { "type": "string" },
        "argv": { "type": "array", "items": { "type": "string" } },
        "returncode": { "type": ["integer", "null"] },
        "timed_out": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    "analysisMode": {
      "type": "string",
      "enum": ["exact", "heuristic", "tool-backed", "unsupported"]
    },
    "nullableAnalysisMode": {
      "oneOf": [
        { "$ref": "#/$defs/analysisMode" },
        { "type": "null" }
      ]
    },
    "capabilityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "argv", "returncode", "timed_out", "truncated"],
      "properties": {
        "purpose": { "type": "string" },
        "argv": { "type": "array", "items": { "type": "string" } },
        "returncode": { "type": "integer" },
        "timed_out": { "type": "boolean" },
        "truncated": { "type": "boolean" }
      }
    },
    "capabilityTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "state",
        "available",
        "complete",
        "required",
        "optional",
        "required_by",
        "optional_by",
        "path",
        "version",
        "version_tuple",
        "error",
        "details",
        "probe_argv",
        "returncode",
        "timed_out",
        "truncated",
        "evidence"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "enum": ["ready", "incomplete", "unavailable"] },
        "available": { "type": "boolean" },
        "complete": { "type": "boolean" },
        "required": { "type": "boolean" },
        "optional": { "type": "boolean" },
        "required_by": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "optional_by": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "path": { "type": "string" },
        "version": { "type": "string" },
        "version_tuple": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "error": { "type": "string" },
        "details": { "type": "object", "additionalProperties": { "type": "string" } },
        "probe_argv": { "type": "array", "items": { "type": "string" } },
        "returncode": { "type": ["integer", "null"] },
        "timed_out": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityEvidence" }
        }
      }
    },
    "capabilityInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "healthy",
        "counts",
        "missing_required",
        "incomplete_required",
        "tools"
      ],
      "properties": {
        "schema_version": { "const": "ici.capabilities/v1" },
        "status": { "type": "string", "enum": ["PASS", "WARN"] },
        "healthy": { "type": "boolean" },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "ready", "incomplete", "unavailable", "required", "optional"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "ready": { "type": "integer", "minimum": 0 },
            "incomplete": { "type": "integer", "minimum": 0 },
            "unavailable": { "type": "integer", "minimum": 0 },
            "required": { "type": "integer", "minimum": 0 },
            "optional": { "type": "integer", "minimum": 0 }
          }
        },
        "missing_required": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "incomplete_required": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "tools": {
          "type": "array",
          "items": { "$ref": "#/$defs/capabilityTool" }
        }
      }
    },
    "nullableCapabilityInventory": {
      "oneOf": [
        { "$ref": "#/$defs/capabilityInventory" },
        { "type": "null" }
      ]
    },
    "supportEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_name",
        "language",
        "mode",
        "active_mode",
        "applicable",
        "enabled",
        "evidence",
        "confidence",
        "frameworks",
        "required_tools",
        "optional_tools",
        "fallback_mode",
        "limitations",
        "reason"
      ],
      "properties": {
        "engine_name": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "enum": ["python", "cpp"] },
        "mode": { "$ref": "#/$defs/analysisMode" },
        "active_mode": { "$ref": "#/$defs/nullableAnalysisMode" },
        "applicable": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "evidence": {
          "type": "string",
          "enum": ["MEASURED", "ESTIMATED", "NOT_RUN", "NOT_APPLICABLE"]
        },
        "confidence": {
          "type": "string",
          "enum": ["exact", "high", "medium", "low"]
        },
        "frameworks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "optional_tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "fallback_mode": { "$ref": "#/$defs/nullableAnalysisMode" },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": "string" }
      }
    },
    "supportMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_languages", "project_frameworks", "entries"],
      "properties": {
        "project_languages": {
          "type": "array",
          "items": { "type": "string", "enum": ["python", "cpp"] },
          "uniqueItems": true
        },
        "project_frameworks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/supportEntry" }
        }
      }
    },
    "nullableSupportMatrix": {
      "oneOf": [
        { "$ref": "#/$defs/supportMatrix" },
        { "type": "null" }
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "relativeOutputPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.$)(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "artifactRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "scope", "kind", "sha256", "size", "mode", "producer"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "scope": { "type": "string", "enum": ["project", "shadow"] },
        "kind": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 },
        "mode": { "type": "integer", "minimum": 0 },
        "producer": { "type": "string", "minLength": 1 }
      }
    },
    "artifactManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "project_root", "shadow_root", "variant", "source_commit",
        "config_digest", "toolchain_digest", "artifacts"
      ],
      "properties": {
        "schema_version": { "const": "ici.artifacts/v1" },
        "project_root": { "const": "." },
        "shadow_root": {
          "oneOf": [
            { "$ref": "#/$defs/relativePath" },
            { "type": "null" }
          ]
        },
        "variant": { "type": "string", "enum": ["release", "coverage", "sanitize"] },
        "source_commit": {
          "type": "string",
          "pattern": "^(?:unavailable|[0-9a-f]{40,64})$"
        },
        "config_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "toolchain_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactRecord" }
        }
      }
    },
    "compilationDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "level", "entry_index", "source"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "level": { "type": "string", "enum": ["info", "warning", "error"] },
        "entry_index": { "type": ["integer", "null"], "minimum": 0 },
        "source": {
          "oneOf": [
            { "$ref": "#/$defs/relativePath" },
            { "const": "" }
          ]
        }
      }
    },
    "compilationDefine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "null"] }
      }
    },
    "compilationSearchPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "scope", "exists"],
      "properties": {
        "path": {
          "oneOf": [
            { "$ref": "#/$defs/relativePath" },
            { "const": "[external]" }
          ]
        },
        "kind": { "type": "string", "enum": ["include", "system", "quote"] },
        "scope": { "type": "string", "enum": ["project", "external"] },
        "exists": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "required": ["scope"],
            "properties": { "scope": { "const": "project" } }
          },
          "then": {
            "properties": { "path": { "$ref": "#/$defs/relativePath" } }
          }
        },
        {
          "if": {
            "required": ["scope"],
            "properties": { "scope": { "const": "external" } }
          },
          "then": {
            "properties": { "path": { "const": "[external]" } }
          }
        }
      ]
    },
    "analysisContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "project", "identity", "compilation",
        "requested_variants", "artifact_manifests"
      ],
      "properties": {
        "schema_version": { "const": "ici.analysis-context/v1" },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name", "version", "type", "source_dirs", "python_sources", "cpp_sources",
            "cpp_headers", "compilable_cpp_sources", "external_cpp_dirs", "cpp_include_flags", "backend",
            "backend_descriptor", "backend_reason"
          ],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "enum": ["python", "cpp", "hybrid"] },
            "source_dirs": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } },
            "python_sources": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } },
            "cpp_sources": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } },
            "cpp_headers": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } },
            "compilable_cpp_sources": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } },
            "external_cpp_dirs": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } },
            "cpp_include_flags": { "type": "array", "items": { "type": "string" } },
            "backend": { "type": ["string", "null"] },
            "backend_descriptor": { "type": "string" },
            "backend_reason": { "type": "string" }
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_commit", "config_digest", "toolchain_digest"],
          "properties": {
            "source_commit": { "type": "string", "pattern": "^(?:unavailable|[0-9a-f]{40,64})$" },
            "config_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "toolchain_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        },
        "profile": {
          "type": "string",
          "enum": ["fast", "standard", "deep"]
        },
        "compilation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["database_path", "units"],
          "properties": {
            "database_path": {
              "oneOf": [
                { "$ref": "#/$defs/relativePath" },
                { "type": "null" }
              ]
            },
            "database_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "diagnostics": {
              "type": "array",
              "maxItems": 200000,
              "items": { "$ref": "#/$defs/compilationDiagnostic" }
            },
            "units": {
              "type": "array",
              "maxItems": 200000,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "directory", "argv", "output"],
                "properties": {
                  "source": { "$ref": "#/$defs/relativePath" },
                  "directory": { "$ref": "#/$defs/relativePath" },
                  "argv": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32768,
                    "items": { "type": "string", "minLength": 1, "maxLength": 1048576 }
                  },
                  "output": {
                    "oneOf": [
                      { "$ref": "#/$defs/relativeOutputPath" },
                      { "const": "" }
                    ]
                  },
                  "compiler": { "type": "string" },
                  "language": {
                    "type": "string",
                    "enum": ["", "c", "c++", "objective-c", "objective-c++"]
                  },
                  "standard": { "type": "string" },
                  "defines": {
                    "type": "array",
                    "maxItems": 32768,
                    "items": { "$ref": "#/$defs/compilationDefine" }
                  },
                  "include_paths": {
                    "type": "array",
                    "maxItems": 32768,
                    "items": { "$ref": "#/$defs/compilationSearchPath" }
                  },
                  "sysroot": {
                    "oneOf": [
                      { "$ref": "#/$defs/relativePath" },
                      { "const": "[external]" },
                      { "const": "" }
                    ]
                  },
                  "sysroot_scope": {
                    "type": "string",
                    "enum": ["", "project", "external"]
                  },
                  "configuration": {
                    "type": "string",
                    "pattern": "^(?:|sha256:[0-9a-f]{64})$"
                  },
                  "diagnostics": {
                    "type": "array",
                    "maxItems": 200000,
                    "items": { "$ref": "#/$defs/compilationDiagnostic" }
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "anyOf": [
                        { "required": ["sysroot"] },
                        { "required": ["sysroot_scope"] }
                      ]
                    },
                    "then": { "required": ["sysroot", "sysroot_scope"] }
                  },
                  {
                    "if": {
                      "required": ["sysroot_scope"],
                      "properties": { "sysroot_scope": { "const": "" } }
                    },
                    "then": { "properties": { "sysroot": { "const": "" } } }
                  },
                  {
                    "if": {
                      "required": ["sysroot_scope"],
                      "properties": { "sysroot_scope": { "const": "project" } }
                    },
                    "then": {
                      "properties": { "sysroot": { "$ref": "#/$defs/relativePath" } }
                    }
                  },
                  {
                    "if": {
                      "required": ["sysroot_scope"],
                      "properties": { "sysroot_scope": { "const": "external" } }
                    },
                    "then": { "properties": { "sysroot": { "const": "[external]" } } }
                  }
                ]
              }
            }
          }
        },
        "requested_variants": {
          "type": "array",
          "items": { "type": "string", "enum": ["release", "coverage", "sanitize"] },
          "uniqueItems": true
        },
        "artifact_manifests": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactManifest" }
        }
      }
    },
    "nullableAnalysisContext": {
      "oneOf": [
        { "$ref": "#/$defs/analysisContext" },
        { "type": "null" }
      ]
    },
    "engine": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "engine_name",
        "status",
        "summary",
        "score",
        "max_score",
        "duration",
        "raw_output",
        "extra",
        "required",
        "evidence",
        "tool_evidence",
        "targets",
        "findings"
      ],
      "properties": {
        "schema_version": { "const": "ici.result/v3" },
        "engine_name": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "summary": { "type": "string" },
        "score": { "$ref": "#/$defs/nullableNumber" },
        "max_score": { "$ref": "#/$defs/nullableNumber" },
        "duration": { "type": "number", "minimum": 0 },
        "raw_output": { "type": "string" },
        "extra": { "type": "object" },
        "required": { "type": "boolean" },
        "evidence": {
          "type": "string",
          "enum": ["MEASURED", "ESTIMATED", "NOT_RUN", "NOT_APPLICABLE"]
        },
        "cache_hit": { "type": "boolean" },
        "cache_key": {
          "oneOf": [
            { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "tool_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolEvidence" }
        },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/target" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "support_matrix": { "$ref": "#/$defs/nullableSupportMatrix" },
        "artifact_manifests": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifactManifest" }
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "suite_status",
        "duration",
        "passed_count",
        "warned_count",
        "failed_count",
        "error_count",
        "skipped_count",
        "total_count",
        "tem_score",
        "max_tem_score",
        "results"
      ],
      "properties": {
        "schema_version": { "const": "ici.result/v3" },
        "suite_status": { "$ref": "#/$defs/status" },
        "duration": { "type": "number", "minimum": 0 },
        "passed_count": { "type": "integer", "minimum": 0 },
        "warned_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 },
        "error_count": { "type": "integer", "minimum": 0 },
        "skipped_count": { "type": "integer", "minimum": 0 },
        "total_count": { "type": "integer", "minimum": 0 },
        "tem_score": { "$ref": "#/$defs/nullableNumber" },
        "max_tem_score": { "type": "number", "minimum": 0 },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/engine" }
        },
        "support_matrix": { "$ref": "#/$defs/nullableSupportMatrix" },
        "analysis_metadata": { "$ref": "#/$defs/nullableAnalysisMetadata" },
        "baseline_comparison": { "$ref": "#/$defs/nullableBaselineComparison" },
        "capability_inventory": { "$ref": "#/$defs/nullableCapabilityInventory" },
        "analysis_context": { "$ref": "#/$defs/nullableAnalysisContext" }
      }
    }
  }
}
