{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jihoon22-lee/ici/schemas/ici-result-v3.schema.json",
  "title": "ici.result/v3",
  "description": "Canonical ici suite or standalone-engine result contract.",
  "oneOf": [
    { "$ref": "#/$defs/suite" },
    { "$ref": "#/$defs/engine" }
  ],
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL", "ERROR", "SKIP"]
    },
    "nullableNumber": {
      "type": ["number", "null"]
    },
    "nullableInteger": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "start_line",
        "end_line",
        "start_column",
        "end_column",
        "label"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "$ref": "#/$defs/nullableInteger" },
        "start_column": { "$ref": "#/$defs/nullableInteger" },
        "end_column": { "$ref": "#/$defs/nullableInteger" },
        "label": { "type": "string" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string" }
      }
    },
    "suppression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suppressed", "kind", "reason"],
      "properties": {
        "suppressed": { "type": "boolean" },
        "kind": {
          "type": "string",
          "enum": ["none", "inline", "config", "baseline"]
        },
        "reason": { "type": "string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "category",
        "severity",
        "confidence",
        "fingerprint",
        "primary_location",
        "related_locations",
        "message",
        "explanation",
        "remediation",
        "tool_rule_id",
        "tool_name",
        "tool_version",
        "suppression",
        "metrics",
        "snippet"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "pattern": "^ici\\.[a-z0-9][a-z0-9.-]*$"
        },
        "category": {
          "type": "string",
          "enum": [
            "correctness",
            "type",
            "security",
            "resource",
            "build",
            "test",
            "maintainability",
            "architecture",
            "compatibility"
          ]
        },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "confidence": {
          "type": "string",
          "enum": ["exact", "high", "medium", "low"]
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "primary_location": { "$ref": "#/$defs/location" },
        "related_locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/location" }
        },
        "message": { "type": "string" },
        "explanation": { "type": "string" },
        "remediation": { "type": "string" },
        "tool_rule_id": { "type": "string" },
        "tool_name": { "type": "string" },
        "tool_version": { "type": "string" },
        "suppression": { "$ref": "#/$defs/suppression" },
        "metrics": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/metric" }
        },
        "snippet": { "type": "string" }
      }
    },
    "analysisMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_version",
        "fingerprint_version",
        "policy_digest",
        "tool_policy_digest"
      ],
      "properties": {
        "producer_version": { "type": "string", "minLength": 1 },
        "fingerprint_version": { "type": "string", "minLength": 1 },
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "tool_policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "nullableAnalysisMetadata": {
      "oneOf": [
        { "$ref": "#/$defs/analysisMetadata" },
        { "type": "null" }
      ]
    },
    "findingDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "engine_name",
        "fingerprint",
        "rule_id",
        "message",
        "current_location",
        "baseline_location",
        "current_severity",
        "baseline_severity",
        "regressed",
        "suppressed",
        "gated"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["new", "unchanged", "moved", "resolved"]
        },
        "engine_name": { "type": "string", "minLength": 1 },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rule_id": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "current_location": {
          "oneOf": [
            { "$ref": "#/$defs/location" },
            { "type": "null" }
          ]
        },
        "baseline_location": {
          "oneOf": [
            { "$ref": "#/$defs/location" },
            { "type": "null" }
          ]
        },
        "current_severity": {
          "type": ["string", "null"],
          "enum": ["info", "low", "medium", "high", "critical", null]
        },
        "baseline_severity": {
          "type": ["string", "null"],
          "enum": ["info", "low", "medium", "high", "critical", null]
        },
        "regressed": { "type": "boolean" },
        "suppressed": { "type": "boolean" },
        "gated": { "type": "boolean" }
      }
    },
    "baselineComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "warnings",
        "baseline_metadata",
        "fail_on_new",
        "gate_failed",
        "new_count",
        "unchanged_count",
        "moved_count",
        "resolved_count",
        "regressed_count",
        "gated_count",
        "entries"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "baseline_metadata": { "$ref": "#/$defs/nullableAnalysisMetadata" },
        "fail_on_new": { "type": "boolean" },
        "gate_failed": { "type": "boolean" },
        "new_count": { "type": "integer", "minimum": 0 },
        "unchanged_count": { "type": "integer", "minimum": 0 },
        "moved_count": { "type": "integer", "minimum": 0 },
        "resolved_count": { "type": "integer", "minimum": 0 },
        "regressed_count": { "type": "integer", "minimum": 0 },
        "gated_count": { "type": "integer", "minimum": 0 },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/findingDelta" }
        }
      }
    },
    "nullableBaselineComparison": {
      "oneOf": [
        { "$ref": "#/$defs/baselineComparison" },
        { "type": "null" }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_path",
        "start_line",
        "end_line",
        "start_column",
        "end_column",
        "target_name",
        "status",
        "message",
        "snippet",
        "metrics"
      ],
      "properties": {
        "file_path": { "type": "string" },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "$ref": "#/$defs/nullableInteger" },
        "start_column": { "$ref": "#/$defs/nullableInteger" },
        "end_column": { "$ref": "#/$defs/nullableInteger" },
        "target_name": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "message": { "type": "string" },
        "snippet": { "type": "string" },
        "metrics": { "type": "object" }
      }
    },
    "toolEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "version",
        "argv",
        "returncode",
        "timed_out",
        "truncated",
        "error"
      ],
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "version": { "type": "string" },
        "argv": { "type": "array", "items": { "type": "string" } },
        "returncode": { "type": ["integer", "null"] },
        "timed_out": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "error": { "type": "string" }
      }
    },
    "analysisMode": {
      "type": "string",
      "enum": ["exact", "heuristic", "tool-backed", "unsupported"]
    },
    "nullableAnalysisMode": {
      "oneOf": [
        { "$ref": "#/$defs/analysisMode" },
        { "type": "null" }
      ]
    },
    "supportEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_name",
        "language",
        "mode",
        "active_mode",
        "applicable",
        "enabled",
        "evidence",
        "confidence",
        "frameworks",
        "required_tools",
        "optional_tools",
        "fallback_mode",
        "limitations",
        "reason"
      ],
      "properties": {
        "engine_name": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "enum": ["python", "cpp"] },
        "mode": { "$ref": "#/$defs/analysisMode" },
        "active_mode": { "$ref": "#/$defs/nullableAnalysisMode" },
        "applicable": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "evidence": {
          "type": "string",
          "enum": ["MEASURED", "ESTIMATED", "NOT_RUN", "NOT_APPLICABLE"]
        },
        "confidence": {
          "type": "string",
          "enum": ["exact", "high", "medium", "low"]
        },
        "frameworks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "optional_tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "fallback_mode": { "$ref": "#/$defs/nullableAnalysisMode" },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": "string" }
      }
    },
    "supportMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_languages", "project_frameworks", "entries"],
      "properties": {
        "project_languages": {
          "type": "array",
          "items": { "type": "string", "enum": ["python", "cpp"] },
          "uniqueItems": true
        },
        "project_frameworks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/supportEntry" }
        }
      }
    },
    "nullableSupportMatrix": {
      "oneOf": [
        { "$ref": "#/$defs/supportMatrix" },
        { "type": "null" }
      ]
    },
    "engine": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "engine_name",
        "status",
        "summary",
        "score",
        "max_score",
        "duration",
        "raw_output",
        "extra",
        "required",
        "evidence",
        "tool_evidence",
        "targets",
        "findings"
      ],
      "properties": {
        "schema_version": { "const": "ici.result/v3" },
        "engine_name": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "summary": { "type": "string" },
        "score": { "$ref": "#/$defs/nullableNumber" },
        "max_score": { "$ref": "#/$defs/nullableNumber" },
        "duration": { "type": "number", "minimum": 0 },
        "raw_output": { "type": "string" },
        "extra": { "type": "object" },
        "required": { "type": "boolean" },
        "evidence": {
          "type": "string",
          "enum": ["MEASURED", "ESTIMATED", "NOT_RUN", "NOT_APPLICABLE"]
        },
        "tool_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolEvidence" }
        },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/target" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "support_matrix": { "$ref": "#/$defs/nullableSupportMatrix" }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "suite_status",
        "duration",
        "passed_count",
        "warned_count",
        "failed_count",
        "error_count",
        "skipped_count",
        "total_count",
        "tem_score",
        "max_tem_score",
        "results"
      ],
      "properties": {
        "schema_version": { "const": "ici.result/v3" },
        "suite_status": { "$ref": "#/$defs/status" },
        "duration": { "type": "number", "minimum": 0 },
        "passed_count": { "type": "integer", "minimum": 0 },
        "warned_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 },
        "error_count": { "type": "integer", "minimum": 0 },
        "skipped_count": { "type": "integer", "minimum": 0 },
        "total_count": { "type": "integer", "minimum": 0 },
        "tem_score": { "$ref": "#/$defs/nullableNumber" },
        "max_tem_score": { "type": "number", "minimum": 0 },
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/engine" }
        },
        "support_matrix": { "$ref": "#/$defs/nullableSupportMatrix" },
        "analysis_metadata": { "$ref": "#/$defs/nullableAnalysisMetadata" },
        "baseline_comparison": { "$ref": "#/$defs/nullableBaselineComparison" }
      }
    }
  }
}
