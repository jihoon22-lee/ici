{
  "schema": 3,
  "scenario_id": "cpp.lsan-memory-leak",
  "class": "stable",
  "project_root": ".",
  "profile": "deep",
  "command": [
    "verify",
    "--profile",
    "deep",
    "--no-cache"
  ],
  "prepare": [
    [
      "cmake",
      "-S",
      ".",
      "-B",
      "build",
      "-DCMAKE_BUILD_TYPE=Debug",
      "-DCMAKE_CXX_FLAGS=-fsanitize=address -g",
      "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
    ],
    [
      "cmake",
      "--build",
      "build",
      "--parallel"
    ]
  ],
  "expected": {
    "gate": "FAIL",
    "exit_code": 1,
    "findings": [
      {
        "provider": "sanitize",
        "rule_id": "ici.sanitize.lsan.memory-leak",
        "path": "src/fault.cpp",
        "line": 3,
        "message_regex": "memory leak"
      }
    ],
    "forbidden_findings": [
      {
        "provider": "sanitize",
        "path": "src/clean.cpp"
      }
    ]
  }
}
